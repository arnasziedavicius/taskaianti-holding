---
const {legalTitle, legalInfo, email, linkedInUrl, instagramUrl} = Astro.props
---
<style>
.Footer {
  width: 100%;
  background-color: var(--color-grey);
  overflow: hidden;
}

.Footer__col span:not(.hidden-mobile),
.Footer__col a {
  display: block;
}

.Footer__logo-link {
  display: block;
  width: 12.4rem;
}

.Footer__logo-icon {
  width: 100%;
  height: auto;
}

@media only screen and (min-width: 992px) {
  .Footer__bottom {
    flex-direction: row-reverse;
  }

  .Footer__col--left {
    text-align: right;
  }

  .Footer__col span:not(.hidden-mobile) {
    display: inline;
  }

  .Footer__col a {
    display: inline-block;
    margin-left: 2.8rem;
  }

  .Footer__col a:first-child {
    margin-left: 0;
  }

  .Footer__logo-link {
    width: 18.4rem;
  }
</style>

