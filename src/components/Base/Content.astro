---
import {PortableText} from 'astro-portabletext'
import AnnotationLinkInternal from './marks/AnnotationLinkInternal.astro'
import AnnotationLinkExternal from './marks/AnnotationLinkExternal.astro'
import AnnotationLinkDownload from './marks/AnnotationLinkDownload.astro'
import DecoratorHighlight from './marks/DecoratorHighlight.astro'

const {value, class: className} = Astro.props

const components = {
  mark: {
    annotationLinkInternal: AnnotationLinkInternal,
    annotationLinkExternal: AnnotationLinkExternal,
    annotationLinkDownload: AnnotationLinkDownload,
    highlight: DecoratorHighlight,
  },
}
---

<div class:list={['BaseContent', 'text', className]}>
  <PortableText value={value} components={components} />
</div>
