---
import BaseContent from '../Base/Content.astro'

const {heading, body} = Astro.props
---

<div class="ModulesText wrap ma-b-xxl ta-c">
  <div class="ModulesText__heading-wrap col ma-b">
    <h2 class="ModulesText__heading tt-u">{heading}</h2>
  </div>

  <div class="ModulesText__body col col-8 col-center">
    <BaseContent value={body} />
  </div>
</div>
