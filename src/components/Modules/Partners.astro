---
import BaseContent from '../Base/Content.astro'

const {title, heading, body} = Astro.props
---

<div class="ModulesPartners wrap ma-b-xxl">
  <div class="ModulesPartners__heading-wrap col ma-b ta-c">
    <h2 class="tt-u">{heading || title}</h2>
  </div>

  <div class="ModulesPartners__body col col-8 col-center">
    <BaseContent value={body} class="ma-b" />

    <a href="" class="button fs-xl">Užpildyk formą →</a>
  </div>
</div>
