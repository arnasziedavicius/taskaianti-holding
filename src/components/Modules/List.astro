---
const {heading, list} = Astro.props
---
<style>
  .ModulesList__item-text {
    text-wrap: pretty;
  }
</style>

<div class="ModulesList wrap ma-b-xxl">
  <div class="ModulesList__heading-wrap col ma-b ta-c">
    <h2 class="ModulesList__heading tt-u">{heading}</h2>
  </div>

  {list.map((item: any) => {
    return <div
      class:list={[
        'ModulesList__item',
        'flex',
        'flex-wrap',
        'ma-b',
        'col-center',
        { 'col-10': item.title },
        { 'ta-c': !item.title },
      ]}
    >
      {item.title && (
        <div class="ModulesList__item-title col col-3-half">
          {item.title}
        </div>
      )}

      <div class:list={[
        'ModulesList__item-text',
        'col',
        { 'col-8-half': item.title },
        { 'col-8': !item.title },
        { 'col-center': !item.title },
      ]}>
        {item.text}
      </div>
    </div>
  })}
</div>
