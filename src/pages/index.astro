---
import DefaultLayout from '../layouts/Default.astro';

const siteTitle = 'Taškai ant i';
const email = 'kontaktai@taskaianti.org';
const url = 'https://www.taskaianti.org/';
const description = 'Pilietinė iniciatyva vienijanti įvairių sričių profesionalus ir siekianti stiprinti atsparumą dezinformacijai Lietuvoje.'

// Structured data for the person
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteTitle,
  "jobTitle": "Pilietinė iniciatyva",
  "description": description,
  "email": email,
  "url": url
};
---
<style>
</style>

<DefaultLayout
  title={siteTitle}
  description={description}
	url={url}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="PageHome page">
		<div class="col col-md-7 col-center text">
			<h1>{siteTitle}</h1>
			<p>{description}</p>
			<p><a href="mailto:info@taskaianti.org">{email}</a></p>
		</div>
  </div>
</DefaultLayout>

<script>

</script>
